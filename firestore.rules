rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // ✅ Common function: check if user is authenticated & owner
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // ✅ Allowed fields only (strict schema)
      function hasValidFields() {
        return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'state',
          'district',
          'language',
          'createdAt'
        ]);
      }

      // ❌ Block sensitive fields completely
      function hasNoSensitiveData() {
        return !request.resource.data.keys().hasAny([
          'aadhaar',
          'ssn',
          'pan',
          'pan_full',
          'password'
        ]);
      }

      // ✅ Basic data validation
      function isValidData() {
        return request.resource.data.state is string
          && request.resource.data.language is string
          && request.resource.data.state.size() > 0
          && request.resource.data.language.size() > 0;
      }

      // ✅ CREATE
      allow create: if isOwner()
                    && hasValidFields()
                    && hasNoSensitiveData()
                    && isValidData();

      // ✅ READ
      allow read: if isOwner();

      // ✅ UPDATE (prevent adding new unwanted fields later)
      allow update: if isOwner()
                    && hasValidFields()
                    && hasNoSensitiveData()
                    && isValidData();

      // ✅ DELETE (optional, keep if needed)
      allow delete: if isOwner();
    }
  }
}