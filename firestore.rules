rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can only read and write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Validation: Ensure no sensitive fields like 'aadhaar' are stored
      allow create, update: if request.resource.data.keys().hasAll(['state', 'language']) 
                           && !request.resource.data.keys().hasAny(['aadhaar', 'ssn', 'pan_full']);
    }
  }
}
