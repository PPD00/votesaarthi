rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL DEFAULTS ---
    // Strictly deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Strict schema validation for Create and Update
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 
          'email', 
          'state', 
          'district', 
          'language', 
          'voiceEnabled', 
          'lastBoothSearch', 
          'createdAt', 
          'updatedAt'
        ])
        && !request.resource.data.keys().hasAny([
          'password', 
          'aadhaar', 
          'pan', 
          'ssn'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string;
    }

    // --- BOOTHS COLLECTION ---
    // Public read-only access for election station data
    match /booths/{boothId} {
      allow read: if true;
      allow write: if false; // Only server/admin can modify
    }

    // --- AI_LOGS COLLECTION ---
    match /ai_logs/{logId} {
      // Users can append their own history but never edit or delete it
      allow create: if isRequestOwner();
      allow read: if isDataOwner();
      allow update, delete: if false;
    }

    // --- BOOTH_SEARCHES COLLECTION ---
    match /booth_searches/{searchId} {
      // Analytics tracking - Create and Read only by owner
      allow create: if isRequestOwner();
      allow read: if isDataOwner();
      allow update, delete: if false;
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notificationId} {
      // In-app alerts - Read only by owner, client cannot write
      allow read: if isDataOwner();
      allow write: if false; // Strict server-side creation only
    }
  }
}